# Kurulum betiği (kur.bat) bu dosyadan bağımsız olarak .env'i kendisi üretir.
# Elle kurulum yapılacaksa bu dosyayı .env olarak kopyalayıp değerleri doldurun.

# Sunucu Ayarları
SERVER_URL=http://localhost:3000
PORT=3000

# Veritabanı Ayarları (proje köküne göre)
DB_PATH=data/crypto.db

# Güvenlik Ayarları (uzun ve rastgele olmalı)
SESSION_SECRET=
# price_updater.js'in sunucuyu tetiklerken kullandığı anahtar (uzun ve rastgele olmalı)
INTERNAL_TOKEN=

# API Ayarları
BINANCE_API_URL=https://api.binance.com/api/v3

# Uygulama Ayarları
# Referans anı. 03:00 İstanbul = 00:00 UTC (Binance günlük mum açılışı)
UPDATE_TIME=03:00
TIMEZONE=Europe/Istanbul

# Telegram bildirimleri (isteğe bağlı; en kolayı: npm run telegram)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Bildirim eşikleri: bir coin, aşağıdakilerin HEPSİ sağlanınca bildirilir
ALERT_MIN_EXCESS=10
ALERT_MIN_VOLUME=5000000
ALERT_MAX_FROM_PEAK=3
ALERT_MIN_MOM15=1
ALERT_COOLDOWN_MIN=60
